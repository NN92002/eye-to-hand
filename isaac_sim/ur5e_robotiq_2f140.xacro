<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
       name="ur5e_robotiq_2f140">

  <!-- ====================================================== -->
  <!-- Existing expanded UR5e                                 -->
  <!-- ====================================================== -->

  <xacro:include filename="ur5e.urdf"/>

  <!-- ====================================================== -->
  <!-- Robotiq 2F-140                                         -->
  <!-- ====================================================== -->

  <xacro:include filename="$(find robotiq_description)/urdf/robotiq_2f_140_macro.urdf.xacro"/>

  <xacro:robotiq_gripper
      name="robotiq_2f140"
      prefix="robotiq_"
      parent="tool0"
      include_ros2_control="false">

    <origin xyz="0 0 0"
            rpy="0 0 0"/>

  </xacro:robotiq_gripper>

</robot>
